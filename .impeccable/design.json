    {"name": "Botón principal", "kind": "button", "refersTo": "button-primary", "description": "Confirmación de la tarea actual.", "html": "<button class='ds-primary'>Confirmar venta</button>", "css": ".ds-primary{background:var(--green,#216747);color:#fff;border:1px solid var(--green,#216747);border-radius:6px;padding:9px 14px;min-height:40px;font:600 14px system-ui;cursor:pointer;transition:background-color 150ms ease}.ds-primary:hover{background:#184d35}.ds-primary:active{background:#184d35}.ds-primary:focus-visible{outline:3px solid #388361;outline-offset:3px}.ds-primary:disabled{opacity:.5;cursor:not-allowed}"},
    {"name": "Botón secundario", "kind": "button", "description": "Acción complementaria.", "html": "<button class='ds-secondary'>Ver ticket</button>", "css": ".ds-secondary{background:white;color:var(--text,#23392f);border:1px solid var(--border,#dce4de);border-radius:6px;padding:9px 14px;min-height:40px;font:600 14px system-ui;cursor:pointer}.ds-secondary:hover{background:#f0f6f2;border-color:#8ea999}.ds-secondary:active{background:#e2eee6}.ds-secondary:focus-visible{outline:3px solid #388361;outline-offset:3px}"},
    {"name": "Campo", "kind": "input", "refersTo": "input", "description": "Etiqueta persistente y foco visible.", "html": "<label class='ds-field'>Nombre o código<input placeholder='Buscar producto'></label>", "css": ".ds-field{display:flex;flex-direction:column;gap:7px;color:var(--text,#23392f);font:500 13px system-ui}.ds-field input{min-height:44px;border:1px solid #bfcfc3;border-radius:6px;background:white;padding:10px 12px;font:15px system-ui;color:var(--text,#23392f)}.ds-field input:focus-visible{outline:3px solid #388361;outline-offset:3px}"},
    {"name": "Filtro", "kind": "chip", "description": "Selección tonal y estado semántico.", "html": "<button class='ds-chip' aria-pressed='true'>Stock bajo</button>", "css": ".ds-chip{border:1px solid var(--border,#dce4de);border-radius:5px;background:white;color:var(--muted,#627169);padding:7px 12px;font:13px system-ui;min-height:36px;cursor:pointer}.ds-chip[aria-pressed=true]{background:var(--soft,#eaf3ed);border-color:#a1bba9;color:var(--green,#216747);font-weight:600}.ds-chip:hover{background:#f3f6f4}.ds-chip:focus-visible{outline:3px solid #388361;outline-offset:3px}"},
    {"name": "Navegación", "kind": "nav", "description": "Texto e icono con selección clara.", "html": "<nav class='ds-nav'><button aria-current='page'><svg viewBox='0 0 24 24' width='20' height='20' fill='none' stroke='currentColor'><path d='M4 3v18h17M9 17v-6M14 17V7M19 17V4'/></svg>Reportes</button></nav>", "css": ".ds-nav{background:var(--sidebar,#184d3c);padding:15px}.ds-nav button{display:flex;align-items:center;gap:12px;min-height:47px;border:0;border-radius:6px;padding:11px 14px;background:#e7f0d9;color:#21452e;font:650 15px system-ui;cursor:pointer}.ds-nav button:hover{background:#d9e8ca}.ds-nav button:focus-visible{outline:3px solid #388361;outline-offset:3px}"},
    {"name": "Panel", "kind": "card", "refersTo": "panel", "description": "Superficie plana de trabajo.", "html": "<section class='ds-panel'><h2>Venta en curso</h2><p>El stock se descuenta al confirmar.</p></section>", "css": ".ds-panel{background:var(--surface,#fff);border:1px solid var(--border,#dce4de);border-radius:9px;padding:22px;color:var(--text,#23392f);font:15px/1.5 system-ui}.ds-panel h2{font-size:20px;font-weight:650;margin:0 0 16px}.ds-panel p{font-size:13px;color:var(--muted,#627169);margin:0}"}
